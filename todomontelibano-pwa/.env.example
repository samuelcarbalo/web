# Copia valores sensibles a `.env.local` (no se sube a Git).
# Las URLs por modo viven en `.env.development` y `.env.production`.

# Backend Django — se sobrescribe por archivo de modo:
#   development → http://127.0.0.1:8000/api/v1
#   production  → https://missingdigitalback.onrender.com/api/v1
VITE_API_URL=http://127.0.0.1:8000/api/v1

VITE_TENANT_SLUG=conectando-empleo
VITE_IMGBB_API_KEY=tu-api-key-imgbb

VITE_SITE_URL=https://chever.co

# Imagen Open Graph / Twitter (URL directa HTTPS, ideal 1200×630)
VITE_OG_IMAGE=https://i.ibb.co/wZNxrY8t/CAPISJ-DIGITAL-logo-principal.jpg

# Mercado Pago — Public Key (la secret va solo en el backend)
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Switch manual en DEV (consola del navegador) ---
