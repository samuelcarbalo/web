# Hostinger / Apache — SPA fallback (React Router)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^index\.html$ - [L]

  # Verificación Google Search Console (archivo estático en raíz)
  RewriteRule ^google[0-9a-f]+\.html$ - [L]

  # llms.txt / robots.txt — servir plano sin SPA fallback
  RewriteRule ^(llms|robots)\.txt$ - [L]

  # No reescribir archivos ni directorios reales (public/*.html, assets, etc.)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Shell HTML — nunca cachear
  <FilesMatch "index\.html$">
    Header unset ETag
    FileETag None
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Texto plano SEO / LLMs
  <FilesMatch "^(llms|robots)\.txt$">
    Header set Content-Type "text/plain; charset=utf-8"
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Logos / íconos estáticos en public/
  <FilesMatch "^(chever.*\.(svg|png)|icon-192x192\.png|icon-512x512\.png|favicon\.ico)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # JS/CSS/fuentes del build (Vite fingerprint)
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # CRÍTICO: sw.js / workbox NUNCA immutable (debe ir DESPUÉS de la regla .js)
  <FilesMatch "^(sw\.js|workbox-.+\.js|notification-sw\.js|manifest\.webmanifest)$">
    Header unset ETag
    FileETag None
    Header unset Cache-Control
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /index.html
