# Hostinger / Apache — SPA fallback (React Router)
# Todas las rutas de cliente deben servir index.html (no buscar carpeta física).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Si ya es index.html, no reescribir
  RewriteRule ^index\.html$ - [L]

  # No reescribir archivos ni directorios reales (assets, favicon, etc.)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Cualquier otra ruta → index.html (React Router resuelve /forgot-password, etc.)
  RewriteRule . /index.html [L]
</IfModule>

# Evitar caché agresiva de index.html (despliegues nuevos)
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|jpg|jpeg|gif|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# Si mod_rewrite no está disponible, ErrorDocument como respaldo
ErrorDocument 404 /index.html
