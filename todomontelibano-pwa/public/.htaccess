# Hostinger / Apache — SPA fallback (React Router) + HTML prerenderizado
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^index\.html$ - [L]

  # Verificación Google Search Console (archivo estático en raíz)
  RewriteRule ^google[0-9a-f]+\.html$ - [L]

  # llms.txt / robots.txt / sitemap.xml — servir plano sin SPA fallback
  RewriteRule ^(llms|robots)\.txt$ - [L]
  RewriteRule ^sitemap\.xml$ - [L]

  # HTML prerenderizado por ruta pública (Googlebot ve H1/H2 sin hidratar React)
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(tienda|deportes|empleos|bienes-raices|eventos|contact|privacy|terms)/?$ $1/index.html [L]

  # No reescribir archivos ni directorios reales (public/*.html, assets, etc.)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Shell HTML — nunca cachear
  <FilesMatch "index\.html$">
    Header unset ETag
    FileETag None
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Texto plano SEO / LLMs
  <FilesMatch "^(llms|robots)\.txt$">
    Header set Content-Type "text/plain; charset=utf-8"
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  <FilesMatch "^sitemap\.xml$">
    Header set Content-Type "application/xml; charset=utf-8"
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Logos / íconos estáticos en public/
  <FilesMatch "^(chever.*\.(svg|png)|icon-192x192\.png|icon-512x512\.png|favicon\.ico)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # JS/CSS/fuentes del build (Vite fingerprint)
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # CRÍTICO: sw.js / workbox NUNCA immutable (debe ir DESPUÉS de la regla .js)
  <FilesMatch "^(sw\.js|workbox-.+\.js|notification-sw\.js|manifest\.webmanifest)$">
    Header unset ETag
    FileETag None
    Header unset Cache-Control
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /index.html
